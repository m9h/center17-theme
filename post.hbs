{{!< default}}
{{#post}}
<article class="{{post_class}} article">
  <header class="article-head">
    <p class="kicker"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>{{#if primary_tag}} &middot; <a href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}} &middot; {{reading_time}}</p>
    <h1 class="article-title">{{title}}</h1>
    {{#if custom_excerpt}}<p class="article-excerpt">{{custom_excerpt}}</p>{{/if}}
  </header>
  {{#if feature_image}}
  <figure class="article-image">
    <img srcset="{{img_url feature_image size="s"}} 600w, {{img_url feature_image size="m"}} 1000w, {{img_url feature_image size="l"}} 1600w" sizes="(max-width: 1000px) 100vw, 1000px" src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
    {{#if feature_image_caption}}<figcaption>{{{feature_image_caption}}}</figcaption>{{/if}}
  </figure>
  {{/if}}
  <section class="content">
    {{content}}
  </section>
  <footer class="article-foot">
    {{#if tags}}<p class="tags">{{tags prefix="Filed under " separator=", "}}</p>{{/if}}
    <p class="authors">{{authors prefix="By " separator=", "}}</p>
  </footer>
</article>
{{/post}}
